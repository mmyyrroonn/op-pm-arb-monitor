# Opinion
OPINION_API_KEY=YOUR_KEY_HERE
# 可选：多 key（逗号分隔）
OPINION_API_KEYS=KEY1,KEY2
# 可选：前端 Bearer 自动登录（请用小额热钱包）
OPINION_PRIVATE_KEY=YOUR_PRIVATE_KEY
# 可选：多私钥（逗号分隔）
OPINION_PRIVATE_KEYS=KEY1,KEY2
# 可选：不填则从私钥推导
OPINION_WALLET_ADDRESS=0xYourWallet
# 可选：不填会自动生成稳定指纹
OPINION_DEVICE_FINGERPRINT=YOUR_DEVICE_FP
# 可选：多指纹（逗号分隔；只有多私钥时才需要）
OPINION_DEVICE_FINGERPRINTS=FP1,FP2

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABCDEF
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
