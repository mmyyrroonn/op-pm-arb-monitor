{
  "market_selector": {
    "source_file": "opinion_topics_merged.json",
    "output_file": "selected_markets.json",
    "market_pairs_file": "market_token_pairs.json",
    "require_market_pairs": false,
    "auto_run_on_missing": false,
    "price_target": 0.5,
    "price_tolerance": 0.2,
    "volume_percentile_min": 0.1,
    "volume_percentile_max": 0.3,
    "max_markets": 2
  },
  "market_switch": {
    "enabled": false,
    "interval_seconds": 3600,
    "cancel_all_on_switch": true,
    "run_selector_on_switch": false
  },
  "quote": {
    "price_source": "orderbook_level",
    "orderbook_level": 5,
    "token_side": "yes",
    "size_per_side": 1,
    "min_size": 1,
    "min_depth_usd": 2000,
    "replace_bps": 5.0
  },
  "risk": {
    "cancel_on_price_proximity": true,
    "proximity_bps": 2,
    "reference_price": "mid"
  },
  "order_sync": {
    "enabled": true,
    "interval_loops": 50,
    "status": "1",
    "limit": 20,
    "max_pages": 3
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "console_level": "INFO",
    "file_level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(message)s",
    "datefmt": "%Y-%m-%d %H:%M:%S",
    "file_enabled": true,
    "file": "mm_info.log",
    "log_orderbook": true,
    "log_state_changes": true,
    "log_order_params": true,
    "log_decisions": true
  },
  "opinion": {
    "host": "https://proxy.opinion.trade:8443",
    "chain_id": 56,
    "api_key_env": "OPINION_API_KEY",
    "rpc_url_env": "OPINION_RPC_URL",
    "private_key_env": "OPINION_PRIVATE_KEY",
    "multi_sig_addr_env": "OPINION_MULTI_SIG",
    "http_min_interval": 0.2,
    "http_timeout_seconds": 15
  },
  "opinion_data": {
    "source": "frontend",
    "frontend_auth_env": "OPINION_FRONTEND_AUTH",
    "frontend_device_fp_env": "OPINION_DEVICE_FINGERPRINT",
    "frontend_waf_env": "OPINION_WAF_TOKEN",
    "frontend_auth_refresh": {
      "enabled": true,
      "interval_seconds": 21600,
      "refresh_before_seconds": 300,
      "min_sleep_seconds": 30,
      "timeout_seconds": 20,
      "refresh_on_start": true,
      "persist_env": true,
      "env_file": ".env"
    }
  },
  "state": {
    "file": "mm_state.json"
  },
  "runtime": {
    "loop_interval_seconds": 3
  }
}
